            "props": {"lay-verify": "required", "maxlength": 100}}
        ]},
        {"row": [
          {"item_name": "NOTES", "label": "备注", "component": "textarea", "props": {"maxlength": 300}}
        ]}
      ],
      "buttonList": []
    }
  ],
  "buttonList": [],
  "initExpress": "@import(asset_initExpress.ql)",
  "submitExpress": "@import(asset_submitExpress.ql)",
  "deleteExpress": "@import(asset_deleteExpress.ql)",
  "appendHead": [
    "<link rel=\"stylesheet\" th:href=\"@{/static/ez-layout/ez-layout.css?v=1}\" href=\"/static/ez-layout/ez-layout.css\">",
    "<script th:src=\"@{/static/ez-layout/ez-layout.js?v=20261018-brand}\" src=\"/static/ez-layout/ez-layout.js?v=20261018-brand\" defer data-layout=\"sidebar\" data-menu=\"/laynavs.html\" data-content-padding=\"10\"></script>",
    "<script src=\"/scaffold/security.js\"></script>"
  ], "appendFoot": []
}
